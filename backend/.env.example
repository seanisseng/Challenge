# Backend environment sample. Copy to .env and fill in real values.
# The backend uses the service-role key (server-side only - never expose it).

# Hosted Supabase project. Dashboard -> Project Settings -> API.
SUPABASE_URL=https://zrfilmdzczsgfzmhfgbd.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (psql / migration tooling).
# Dashboard -> Connect -> Direct connection
DATABASE_URL=postgresql://postgres:<db-password>@db.zrfilmdzczsgfzmhfgbd.supabase.co:5432/postgres

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Admin gate ---------------------------------------------------------
# No user accounts exist. This PIN protects session creation and photo
# approval. Pick your own; it is typed once at /admin.
ADMIN_PIN=change-me
