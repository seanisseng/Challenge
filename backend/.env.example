# Backend environment sample. Copy to .env and fill in real values.
#
# The backend is the only component that talks to Supabase, and it uses the
# elevated key below. Nothing else needs a Supabase key.

# Hosted Supabase project. Dashboard -> Settings -> API Keys.
SUPABASE_URL=https://ceqfgjqwvuqhtsbmxfdn.supabase.co

# Paste ONE of these:
#   SUPABASE_SECRET_KEY=sb_secret_...     new style, preferred
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...      legacy JWT, valid until end of 2026
# Both resolve to the service_role Postgres role and bypass RLS, so this file
# must never be committed or shipped to a browser.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (psql / migration tooling only).
# Dashboard -> Connect -> Direct connection
DATABASE_URL=postgresql://postgres:<db-password>@db.ceqfgjqwvuqhtsbmxfdn.supabase.co:5432/postgres

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Admin gate ---------------------------------------------------------
# No user accounts exist. This PIN protects session creation and photo
# approval. Pick your own; it is typed once at /admin.
ADMIN_PIN=change-me

# --- Game content -------------------------------------------------------
# Substituted for the {{phone}} token in challenge text, so the real number
# never has to be committed or written to the database. Leave blank and
# players see "the number your station leader gives you" instead.
CONTACT_PHONE=
