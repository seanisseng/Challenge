# Frontend environment sample. Copy to .env.
#
# The browser never talks to Supabase: all reads and writes go through the
# FastAPI backend, which holds the service-role key. So no Supabase keys are
# needed here — only the backend's address.

# Blank uses the current website's origin, including Vercel preview URLs.
# Local development forwards /api and /ws to the backend through Vite.
# Import this variable into Vercel as Config, not Secret.
VITE_API_BASE_URL=
