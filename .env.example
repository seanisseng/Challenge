# ---------------------------------------------------------------------------
# Shared environment sample. Copy to .env and fill in real values.
# Never commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Supabase (backend uses the service-role key; frontend uses the anon key) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres direct connection (Supabase CLI local default)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite exposes VITE_* to the browser) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8000
