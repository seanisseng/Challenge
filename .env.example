# ---------------------------------------------------------------------------
# Shared environment sample. Copy to .env and fill in real values.
# Never commit a populated .env file.
#
# The backend is the only thing that talks to Supabase. The frontend just needs
# VITE_API_BASE_URL, so no Supabase keys belong in frontend/.env.
# ---------------------------------------------------------------------------

# --- Supabase (backend only) ---
SUPABASE_URL=https://zrfilmdzczsgfzmhfgbd.supabase.co

# Paste ONE of these (Dashboard -> Settings -> API Keys):
#   SUPABASE_SECRET_KEY=sb_secret_...     new style, preferred
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...      legacy JWT, valid until end of 2026
# Both map to the service_role Postgres role and bypass RLS.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (psql / migration tooling only)
DATABASE_URL=postgresql://postgres:<db-password>@db.zrfilmdzczsgfzmhfgbd.supabase.co:5432/postgres

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Admin gate ---
# There are no user accounts. This PIN is the only thing protecting session
# creation and photo approval. Pick your own before the real game.
ADMIN_PIN=change-me

# --- Frontend (Vite exposes VITE_* to the browser) ---
VITE_API_BASE_URL=http://localhost:8000

# Optional MapLibre style URL. Defaults to the bundled light OpenMapTiles style.
# Tiles, fonts and icons are hosted by OpenFreeMap; no API key is required.
# VITE_MAP_STYLE_URL=https://your-tile-server/styles/game/style.json
